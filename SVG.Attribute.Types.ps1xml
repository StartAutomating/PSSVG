      </NoteProperty>
      <NoteProperty>
        <Name>Name</Name>
        <Value>xChannelSelector</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>PSTypeName</Name>
        <Value>SVG.Attribute</Value>
      </NoteProperty>
    </Members>
  </Type>
  <Type>
