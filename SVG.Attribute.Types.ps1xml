        <Value>System.Collections.Hashtable</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>IsDeprecated</Name>
        <Value>False</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>Name</Name>
        <Value>fill</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>PSTypeName</Name>
        <Value>SVG.Attribute</Value>
      </NoteProperty>
    </Members>
