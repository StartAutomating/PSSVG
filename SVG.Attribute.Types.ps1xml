    <Members>
      <NoteProperty>
        <Name>AppliesTo</Name>
        <Value>title a animate animateMotion animateTransform cursor feImage filter font-face-uri glyphRef image linearGradient mpath pattern radialGradient script set textPath tref use</Value>
      </NoteProperty>
