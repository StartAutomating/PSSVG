        <Value>True</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>Name</Name>
        <Value>ascent</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>PSTypeName</Name>
        <Value>SVG.Attribute</Value>
      </NoteProperty>
    </Members>
  </Type>
  <Type>
    <Name>SVG.Attribute.slope</Name>
    <Members>
      <NoteProperty>
        <Name>AppliesTo</Name>
        <Value>font-face</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>Description</Name>
        <Value>

{{SVGRef}}

The **`slope`** attribute indicates the vertical stroke angle of a font.

You can use this attribute with the following SVG elements:

- [font-face](https://developer.mozilla.org/en-US/web/svg/element/font-face)
</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>Group</Name>
        <Value>elements</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>Header</Name>
        <Value>System.Collections.Hashtable</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>IsDeprecated</Name>
        <Value>True</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>Name</Name>
        <Value>slope</Value>
      </NoteProperty>
