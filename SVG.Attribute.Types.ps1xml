    <Name>SVG.Attribute.clip-rule</Name>
    <Members>
      <NoteProperty>
        <Name>AppliesTo</Name>
        <Value>
        </Value>
      </NoteProperty>
      <NoteProperty>
        <Name>Category</Name>
