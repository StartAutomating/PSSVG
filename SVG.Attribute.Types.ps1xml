        <Value>False</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>Name</Name>
        <Value>fill-opacity</Value>
      </NoteProperty>
      <NoteProperty>
        <Name>PSTypeName</Name>
        <Value>SVG.Attribute</Value>
      </NoteProperty>
