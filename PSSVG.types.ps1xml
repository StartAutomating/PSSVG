    SVG.Text -X 50% -Y 50% -DominantBaseline 'middle' -AlignmentBaseline 'middle' -TextAnchor 'middle' -Fontsize 100 -Fill '#4488ff' -Content @(
        (SVG.tspan -Content '404').OuterXml
        SVG.Animate -AttributeName 'font-size' -Values '100;110;100' -Dur '1s' -RepeatCount 'indefinite'
    )
)

                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>RequestCache</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the request cache for PSSVG.    
.DESCRIPTION
    Gets the request cache for PSSVG.

    This contains the paths that have been requested and their output.
#&gt;
param()
if (-not $this.'.RequestCache') {
    $this.psobject.properties.add([psnoteproperty]::new('.RequestCache', [Ordered]@{}), $true)
}
return $this.'.RequestCache'

                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>RouteCache</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the route cache for PSSVG.
.DESCRIPTION
    Gets the route cache for PSSVG.

    This contains the routes that have been requested, and their destinations.
#&gt;
param()
if (-not $this.'.RouteCache') {
    $this.psobject.properties.add([psnoteproperty]::new('.RouteCache', [Ordered]@{}), $true)
}
return $this.'.RouteCache'
                    </GetScriptBlock>
